{
  "name": "kairo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "kairo": "./dist/interface/cli/index.js"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm exec tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build && node --test \"dist/**/*.test.js\"",
    "start": "tsx src/interface/cli/index.ts"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@openrouter/sdk": "^1.2.145",
    "@sentry/node": "10.37.0",
    "better-sqlite3": "^12.0.0",
    "deepeval": "0.9.14",
    "groq-sdk": "1.6.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
