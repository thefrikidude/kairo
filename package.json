{
  "name": "@mrace07/kairo",
  "version": "0.1.2",
  "private": true,
  "description": "A local desktop workspace for interactive coding-agent terminals and Git review.",
  "keywords": [
    "ai",
    "coding-agent",
    "desktop",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thefrikidude/kairo.git"
  },
  "homepage": "https://github.com/thefrikidude/kairo#readme",
  "bugs": {
    "url": "https://github.com/thefrikidude/kairo/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "rm -rf dist && pnpm exec tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build && node --test \"dist/**/*.test.js\"",
    "desktop:dev": "node node_modules/electron/install.js && ELECTRON_ENTRY=out/main/index.js electron-vite dev",
    "desktop:build": "electron-vite build",
    "desktop:preview": "node node_modules/electron/install.js && ELECTRON_ENTRY=out/main/index.js electron-vite preview",
    "postinstall": "node scripts/prepare-terminal.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.0.0",
    "highlight.js": "^11.12.0",
    "node-pty": "^1.1.0",
    "parse-diff": "0.12.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.6",
    "react-dom": "^19.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.6"
  }
}
